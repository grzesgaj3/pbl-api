# --- Database -------------------------------------------------------------
# MariaDB / MySQL connection string (PyMySQL driver).
# Always set the session timezone to UTC; the engine also enforces it.
DATABASE_URL=mysql+pymysql://pbl:pbl_secret@127.0.0.1:3306/pbl?charset=utf8mb4

# --- Application ----------------------------------------------------------
# Secret used by the admin endpoints (creating clean commands, listing all data).
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change-me

# Optional tuning
# For a small VPS keep a tiny pool: one worker with a handful of threads is
# plenty for a rain-gauge network.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3
DB_POOL_RECYCLE=1800
LOG_LEVEL=info

# Serve /docs, /redoc and /openapi.json (set to false in production if unused).
ENABLE_DOCS=true

# Comma-separated list of allowed CORS origins (empty = CORS disabled).
CORS_ORIGINS=
